# Copy to fastlane/.env and fill in. Never commit the filled copy.
#
# App Store Connect API key — drives match and notarization.
# The .p8 itself is not stored here: put it in
# ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8
ASC_KEY_ID=
ASC_ISSUER_ID=

# Private git repo holding the encrypted Developer ID certificate (match).
MATCH_REPOSITORY_URL=

# Passphrase that decrypts the match repo.
MATCH_PASSWORD=
